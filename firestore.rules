
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isVendor() {
      return isAuthenticated() && (
      getUserData().role == 'vendor' ||
      getUserData().role == 'mechmaster'
      );
    }

    function isCustomer() {
      return isAuthenticated() && getUserData().role == 'customer';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────
    // users/{userId}
    // ─────────────────────────────────────────
    // Fields only the server (Admin SDK) or an admin may set. Changing `role`
    // from the client would make anyone an admin (isAdmin() reads it).
    function userProtectedFields() {
      return ['id', 'email', 'role', 'status', 'emailVerified', 'isActive', 'isVerified',
              'permissions', 'rating', 'createdAt', 'joinedAt'];
    }

    match /users/{userId} {
      // Your own profile, or admin. Vendor docs hold email, phone, workshop address,
      // GST and revenue, and rules can't hide fields — public vendor cards come from
      // GET /api/v1/vendors/directory (Admin SDK, card fields only).
      allow read: if isOwner(userId) || isAdmin();

      // Profiles are provisioned by the server; a client may only create
      // non-privileged fields on its own doc (e.g. a cart saved before provisioning).
      allow create: if isOwner(userId) &&
                    !request.resource.data.keys().hasAny(userProtectedFields());

      // Users update their own non-privileged fields; admin can update anyone.
      allow update: if isAdmin() || (
                      isOwner(userId) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields())
                    );

      // Only admin can delete
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // rfqs/{rfqId}
    // ─────────────────────────────────────────
    match /rfqs/{rfqId} {
      allow read: if isAuthenticated() && (
        // Customer who owns the RFQ
        resource.data.userId == request.auth.uid ||
        // Admin has full visibility
        isAdmin() ||
        // Vendor shortlisted on this RFQ
        (isVendor() && (
          request.auth.uid in resource.data.shortlistedVendorIds ||
          request.auth.uid == resource.data.assignedVendorId
        ))
      );

      // Any authenticated user can submit an RFQ, but must set their own userId
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() && (
        // Owner can update their own RFQ (e.g. edit before submission)
        resource.data.userId == request.auth.uid ||
        // Admin can update anything (status, assignment, shortlist)
        isAdmin() ||
        // Assigned vendor can update production status
        (isVendor() && request.auth.uid == resource.data.assignedVendorId)
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // projectRFQs/{projectId}
    // ─────────────────────────────────────────
    // Price, payment, vendor-assignment and workflow fields are written by admins
    // or server routes only. payment/create-order charges finalPrice/quotedPrice.
    function projectProtectedFields() {
      return ['userId', 'quotedPrice', 'finalPrice', 'leadTimeDays', 'paymentStatus',
              'assignedVendorId', 'shortlistedVendorIds', 'invitedVendorIds', 'assignmentState',
              'workflowStatus', 'acceptedAt', 'assignedAt', 'invitedAt', 'acceptedQuotationId',
              'razorpayOrderId', 'paidAt', 'artifacts', 'timelineEvents',
              'negotiationHistory', 'instantCostSnapshot', 'quoteRequestedAt'];
    }

    // RFQ-send (draft -> quote_requested) and negotiation (-> negotiation) now go
    // through server routes. The only status move a customer still makes directly
    // is accepting a quote.
    function customerStatusChange(fromStatus, toStatus) {
      return (fromStatus == 'quotation_sent' || fromStatus == 'negotiation') && toStatus == 'accepted';
    }

    match /projectRFQs/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Owner creates a draft (or a matching-flow submission) with no price/payment data.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['draft', 'submitted'] &&
        !request.resource.data.keys().hasAny(['quotedPrice', 'finalPrice', 'leadTimeDays',
          'paymentStatus', 'workflowStatus', 'assignmentState', 'acceptedAt', 'assignedAt',
          'acceptedQuotationId', 'razorpayOrderId', 'paidAt']) &&
        request.resource.data.get('assignedVendorId', null) == null;

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(projectProtectedFields()) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          customerStatusChange(resource.data.get('status', ''), request.resource.data.get('status', ''))
        )
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'draft'
      );
    }

    // ─────────────────────────────────────────
    // projectParts/{partId}
    // ─────────────────────────────────────────
    // Admin prices parts (unitCost); customers edit parts only while the project
    // is still a draft, so quantities can't change after a price is agreed.
    function partProtectedFields() {
      return ['userId', 'projectId', 'unitCost', 'totalCost', 'price', 'quotedPrice',
              'instantQuote', 'quoteStatus', 'quoteNote'];
    }

    function isOwnDraftProject(projectId) {
      let project = get(/databases/$(database)/documents/projectRFQs/$(projectId)).data;
      return project.userId == request.auth.uid && project.status == 'draft';
    }

    match /projectParts/{partId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isOwnDraftProject(request.resource.data.projectId) &&
        !request.resource.data.keys().hasAny(['unitCost', 'totalCost', 'price', 'quotedPrice',
          'instantQuote', 'quoteStatus', 'quoteNote'])
      );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        isOwnDraftProject(resource.data.projectId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(partProtectedFields())
      );

      // Owner deletes parts of a draft project, or of a project already deleted
      // (the dashboard removes a draft project and its parts together).
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid && (
          !exists(/databases/$(database)/documents/projectRFQs/$(resource.data.projectId)) ||
          isOwnDraftProject(resource.data.projectId)
        )
      );
    }

    // ─────────────────────────────────────────
    // quotations/{quotationId}
    // ─────────────────────────────────────────
    match /quotations/{quotationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );

      // An accepted quotedPrice is what the customer pays, so vendors bid, revise and
      // accept only through /api/v1/projects/[id]/quotations/* (server-validated).
      // A direct client write could bid on any project at any price.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // negotiations/{negotiationId}
    // ─────────────────────────────────────────
    match /negotiations/{negotiationId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );

      // Creator must identify themselves as the customer in the negotiation document
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();

      // ── Subcollection: messages ──
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.vendorId == request.auth.uid ||
          isAdmin()
        );

        // Parties in the negotiation + admin can write messages
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.vendorId == request.auth.uid ||
          isAdmin()
        );

        // Messages are immutable after creation (no edits, no deletes by users)
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────
    // reviews/{reviewId}
    // ─────────────────────────────────────────
    match /reviews/{reviewId} {
      // Public reviews readable by anyone for vendor profile pages
      allow read: if resource.data.isPublic == true || isAuthenticated();

      // Only the customer who completed the project can write a review
      allow create: if isAuthenticated() && isOwner(request.resource.data.customerId);

      // Only admin can edit/delete reviews
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // notifications/{notificationId}
    // ─────────────────────────────────────────
    match /notifications/{notificationId} {
      // User can read and mark-as-read their own notifications
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Only admin can create notifications (cloud functions handle this)
      allow create: if isAdmin();

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ─────────────────────────────────────────
    // vendorCapabilities/{capabilityId}
    // ─────────────────────────────────────────
    match /vendorCapabilities/{capabilityId} {
      // Anyone authenticated can read capabilities (for RFQ matching)
      allow read: if isAuthenticated();

      // Vendor can manage their own capabilities; admin can manage any
      allow create: if (isVendor() && request.resource.data.vendorId == request.auth.uid) || isAdmin();
      allow update, delete: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
    }

    // ─────────────────────────────────────────
    // uploaded_files/{fileId}
    // ─────────────────────────────────────────
    match /uploaded_files/{fileId} {
      // File ownership records — written only by the server when it authorises an
      // upload; downloads trust them, so no client may read or write them.
      allow read, write: if false;
    }

    // ─────────────────────────────────────────
    // consultationRequests/{requestId}
    // ─────────────────────────────────────────
    match /consultationRequests/{requestId} {
      // Created only by POST /api/v1/consultation (validated, rate-limited)
      allow create: if false;

      // Only admin reads and manages leads
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // contactQueries/{queryId}
    // ─────────────────────────────────────────
    match /contactQueries/{queryId} {
      // Created only by POST /api/v1/contact (validated, rate-limited)
      allow create: if false;

      // Only admin reads and manages contact queries
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // newsletter_subscribers/{docId}
    // ─────────────────────────────────────────
    match /newsletter_subscribers/{docId} {
      // Created only by POST /api/v1/newsletter (validated, rate-limited, idempotent)
      allow create: if false;

      // Only admin can read and manage subscribers
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // blog_stats/{slug}
    // ─────────────────────────────────────────
    match /blog_stats/{slug} {
      // Anyone can read blog stats (likes, views)
      allow read: if true;
      
      // Authenticated users can create stats and increment specific counters.
      // Update is restricted to only known counter fields to prevent arbitrary overwrites.
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['views', 'likes', 'comments', 'updatedAt']);
      
      // Only admin can delete stats
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // blog_comments/{commentId}
    // ─────────────────────────────────────────
    match /blog_comments/{commentId} {
      // Anyone can read comments
      allow read: if true;

      // Any authenticated user can create a comment
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Only the comment author or an admin can delete it
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Comments are currently immutable (cannot be updated)
      allow update: if false;
    }

    // ─────────────────────────────────────────
    // products/{productId}
    // ─────────────────────────────────────────
    match /products/{productId} {
      // Public: anyone can view products in the shop
      allow read: if true;

      // Only admin can manage the catalogue
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // orders/{orderId}
    // ─────────────────────────────────────────
    match /orders/{orderId} {
      // Users can read their own orders; admin reads all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Orders are created only by the server (/api/v1/order/create, shop checkout),
      // after pricing from saved quotes / the product catalogue.
      allow create: if false;

      // Only admin can update order status or delete
      allow update, delete: if isAdmin();
    }
    // ─────────────────────────────────────────
    // restockRequests/{requestId}
    // ─────────────────────────────────────────
    match /restockRequests/{requestId} {
      // Only authenticated users can create a request for themselves
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['productId', 'userId', 'productName', 'sku', 'userEmail', 'requestedAt', 'status'])
                    && request.resource.data.productId is string
                    && request.resource.data.productId.size() > 0
                    && request.resource.data.productId.size() <= 128
                    && request.resource.data.userId == request.auth.uid;
      
      // Only admin can read and manage demand index
      allow read, update, delete: if isAdmin();
    }
    // ─────────────────────────────────────────
    // vendorApplications/{applicationId}
    // ─────────────────────────────────────────
    match /vendorApplications/{applicationId} {
      // Admin can read all applications; owner can read their own.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Applicant can create their own pending application.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ndaAgreed == true;

      // Only admin can review/update/delete.
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // vendorApplications/{applicationId}
    // ─────────────────────────────────────────
    match /vendorApplications/{applicationId} {
      // Admin can read all applications; owner can read their own.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Applicant can create their own pending application.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ndaAgreed == true;

      // Only admin can review/update/delete.
      allow update, delete: if isAdmin();
    }

  }
}
